# Copy to .env (gitignored) and fill in. Shell exports still win if already set.
# https://huggingface.co/settings/tokens  (read token)
# Accept terms for both:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=

# Inference refuses the network. `make models` is the download step and turns this off.
HF_HUB_OFFLINE=1

# Notes model. Apple MLX 4-bit Qwen2.5-7B-Instruct.
# The Qwen org repo Qwen/Qwen2.5-7B-Instruct-MLX no longer exists.
# LLM_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit

